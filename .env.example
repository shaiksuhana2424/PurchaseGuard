# Copy this file to .env. Do not commit .env or share secret values.
PORT=8080
RATE_LIMIT_PER_MINUTE=40
PROVIDER_TIMEOUT_MS=9000
# One licensed Google Shopping discovery API key can search across multiple retailers.
# Coverage varies by product and location; it cannot guarantee all 11 retailers for every query.
# API signup/documentation: https://serpapi.com/google-shopping-api
SERPAPI_KEY=
SHOPPING_COUNTRY=in
SHOPPING_LANGUAGE=en
SHOPPING_GOOGLE_DOMAIN=google.co.in
# Optional city-level location, e.g. Hyderabad, Telangana, India
SHOPPING_LOCATION=

# Optional direct-provider override per retailer. Endpoint must accept GET ?q=<query> and
# return JSON with an array at the configured OFFERS_PATH (default: offers).
# Supported fields: title, price, url/link, currency, inStock, brand, model, variant, sku/productId, gtin.
# API key is sent as Bearer token; use HEADER_NAME/VALUE for an alternate required header.
AMAZON_API_URL=
AMAZON_API_KEY=
AMAZON_API_HEADER_NAME=
AMAZON_API_HEADER_VALUE=
AMAZON_OFFERS_PATH=offers
AMAZON_QUERY_PARAM=q
FLIPKART_API_URL=
FLIPKART_API_KEY=
FLIPKART_API_HEADER_NAME=
FLIPKART_API_HEADER_VALUE=
FLIPKART_OFFERS_PATH=offers
FLIPKART_QUERY_PARAM=q
MYNTRA_API_URL=
MYNTRA_API_KEY=
MYNTRA_API_HEADER_NAME=
MYNTRA_API_HEADER_VALUE=
MYNTRA_OFFERS_PATH=offers
MYNTRA_QUERY_PARAM=q
MEESHO_API_URL=
MEESHO_API_KEY=
MEESHO_API_HEADER_NAME=
MEESHO_API_HEADER_VALUE=
MEESHO_OFFERS_PATH=offers
MEESHO_QUERY_PARAM=q
CROMA_API_URL=
CROMA_API_KEY=
CROMA_API_HEADER_NAME=
CROMA_API_HEADER_VALUE=
CROMA_OFFERS_PATH=offers
CROMA_QUERY_PARAM=q
RELIANCE_DIGITAL_API_URL=
RELIANCE_DIGITAL_API_KEY=
RELIANCE_DIGITAL_API_HEADER_NAME=
RELIANCE_DIGITAL_API_HEADER_VALUE=
RELIANCE_DIGITAL_OFFERS_PATH=offers
RELIANCE_DIGITAL_QUERY_PARAM=q
VIJAY_SALES_API_URL=
VIJAY_SALES_API_KEY=
VIJAY_SALES_API_HEADER_NAME=
VIJAY_SALES_API_HEADER_VALUE=
VIJAY_SALES_OFFERS_PATH=offers
VIJAY_SALES_QUERY_PARAM=q
TATA_CLIQ_API_URL=
TATA_CLIQ_API_KEY=
TATA_CLIQ_API_HEADER_NAME=
TATA_CLIQ_API_HEADER_VALUE=
TATA_CLIQ_OFFERS_PATH=offers
TATA_CLIQ_QUERY_PARAM=q
AJIO_API_URL=
